{
  "name": "n8n-nodes-chatmodel-reasoning",
  "version": "1.2.2",
  "description": "n8n ChatModel node with extended reasoning/thinking support for OpenRouter, DeepSeek, and any OpenAI-compatible API",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && node scripts/copy-assets.js",
    "dev": "tsc -w",
    "prepack": "npm run build",
    "lint": "eslint src --ext .ts"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/OpenAiCompatibleReasoningApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/LmChatReasoning/LmChatReasoning.node.js"
    ]
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "ai",
    "llm",
    "reasoning",
    "thinking",
    "openrouter",
    "deepseek"
  ],
  "dependencies": {
    "@langchain/core": "1.2.8",
    "@langchain/openai": "1.4.4",
    "@n8n/ai-utilities": "0.30.2"
  },
  "peerDependencies": {
    "n8n-workflow": "2.37.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "n8n-workflow": "2.37.2",
    "typescript": "^5.4.0"
  }
}
